<!DOCTYPE html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>zork — Pete van Wesep</title>
    <meta name="description" content="A tiny text adventure, running Python in your browser via Skulpt.">
    <meta name="theme-color" content="#15140f">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,460&family=JetBrains+Mono:wght@400;500&display=swap">

    <%= render 'layouts/google_analytics' %>

    <script type="text/javascript">
      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // Append program output to the <pre>.
      function outf(text) {
        var pre = document.getElementById("output");
        pre.innerHTML += escapeHtml(text);
        window.scrollTo(0, document.body.scrollHeight);
      }

      function builtinRead(x) {
        if (Sk.builtinFiles === undefined || Sk.builtinFiles["files"][x] === undefined)
          throw "File not found: '" + x + "'";
        return Sk.builtinFiles["files"][x];
      }

      // Skulpt calls this for every input() in the program. Returning a Promise
      // suspends the interpreter until the player submits a command.
      function inputFun(promptText) {
        return new Promise(function (resolve) {
          var form  = document.getElementById("input-line");
          var input = document.getElementById("input");
          var label = document.getElementById("prompt-label");
          label.textContent = (promptText && promptText.trim()) ? promptText : ">";
          form.hidden = false;
          input.value = "";
          input.focus();
          window.scrollTo(0, document.body.scrollHeight);

          function onSubmit(e) {
            e.preventDefault();
            var value = input.value;
            var pre = document.getElementById("output");
            pre.innerHTML += '<span class="echo">' + escapeHtml(label.textContent + " " + value) + "</span>\n";
            input.value = "";
            form.hidden = true;
            form.removeEventListener("submit", onSubmit);
            resolve(value);
          }
          form.addEventListener("submit", onSubmit);
        });
      }

      function runit() {
        var prog = document.getElementById("code").innerHTML
          .replace(/&amp;/g, '&')
          .replace(/&lt;/g, '<')
          .replace(/&gt;/g, '>')
          .replace(/&quot;/g, '"')
          .replace(/&#039;/g, "'");

        document.getElementById("output").innerHTML = '';
        Sk.pre = "output";
        Sk.configure({
          output: outf,
          read: builtinRead,
          inputfun: inputFun,
          inputfunTakesPrompt: true,
          __future__: Sk.python3
        });

        var promise = Sk.misceval.asyncToPromise(function () {
          return Sk.importMainWithBody("<stdin>", false, prog, true);
        });
        promise.then(
          function () {
            document.getElementById("input-line").hidden = true;
          },
          function (err) {
            document.getElementById("input-line").hidden = true;
            outf("\n" + err.toString() + "\n");
            console.log(err.toString());
          }
        );
      }
    </script>

    <%= stylesheet_link_tag 'python', media: 'all', 'data-turbolinks-track' => true %>
    <%= csrf_meta_tags %>
  </head>
  <body onload="runit()">
    <%= yield %>
    <%= javascript_include_tag 'skulpt', 'data-turbolinks-track' => true %>
  </body>
</html>
