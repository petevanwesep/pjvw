<!DOCTYPE html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Pete van Wesep — Engineering Leader</title>
    <meta name="description" content="Pete van Wesep — hands-on engineering leader in Oakland, CA, building empathetic teams and high-leverage software.">

    <meta property="og:title"     content="Pete van Wesep — Engineering Leader">
    <meta property="og:description" content="Hands-on engineering leader in Oakland, CA, building empathetic teams and high-leverage software.">
    <meta property="og:url"       content="https://pjvw.io">
    <meta property="og:site_name" content="Pete van Wesep">
    <meta property="og:type"      content="website">
    <meta name="theme-color" content="#faf7f2">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,460;9..144,600&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">

    <%= render 'layouts/google_analytics' %>

    <%= stylesheet_link_tag 'application.css', media: 'all', 'data-turbolinks-track' => true %>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <%= yield %>
    <%= javascript_include_tag 'manifest', 'data-turbolinks-track' => true %>
  </body>
</html>
